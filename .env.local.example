# Local development only. Copy to .env.local and fill with local/test values.
# Do not point these variables at production services.

# Supabase local/dev PostgreSQL. Prefer a separate Supabase project or Supabase CLI local DB.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
DIRECT_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"

# Local app URLs.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-local-secret"
CLEANUP_SECRET="replace-with-local-cleanup-secret"

# Optional locally. Use Google OAuth test credentials if testing Google login.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe test mode only.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_MONTHLY="price_test_monthly"
STRIPE_PRICE_SEASON="price_test_season"
STRIPE_REFERRAL_COUPON_ID="coupon_test_referral"

# Local QA console.
QA_MODE="true"
QA_ALLOW_PRODUCTION_LOCAL="false"
QA_SECRET="replace-with-local-qa-secret"

# NBA data source for local dev.
# Use "local" to read committed JSON fixtures from src/app/data.
# Use "storage" only when you want to test against the local/dev Supabase bucket below.
NBA_DATA_SOURCE="local"
NBA_STORAGE_MANIFEST="qa-current.json"
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_SECRET_KEY="replace-with-local-service-role-key"
SUPABASE_STORAGE_BUCKET="nba-data-dev"
