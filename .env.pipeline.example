# Dedicated environment for update_data.py / cron.
# Copy to .env.pipeline on the machine that publishes NBA data.
# This file is intentionally separate from .env.local so a local dev server
# cannot accidentally publish to production storage.

# Local/dev publishing target:
SUPABASE_URL="http://127.0.0.1:54321"
SUPABASE_SECRET_KEY="replace-with-local-service-role-key"
SUPABASE_STORAGE_BUCKET="nba-data-dev"
NBA_STORAGE_MANIFEST="qa-current.json"

# Production publishing target:
# SUPABASE_URL="https://PROJECT_REF.supabase.co"
# SUPABASE_SECRET_KEY="sb_secret_..."
# SUPABASE_STORAGE_BUCKET="nba-data"
# NBA_STORAGE_MANIFEST="current.json"

# Optional snapshot controls.
NBA_DATA_SOURCE="storage"
NBA_QA_DATE=""
NBA_STATS_SEASON="2025-26"
NBA_PREV_SEASON="2024-25"
NBA_ROSTER_SEASON="2025-26"

# Set to true only if you also want update_data.py to overwrite local JSON files.
NBA_WRITE_LOCAL_DATA="false"
