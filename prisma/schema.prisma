generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                      String                   @id @default(cuid())
  name                    String?
  email                   String                   @unique
  image                   String?
  createdAt               DateTime                 @default(now())
  password                String?
  plan                    String                   @default("free")
  stripeCustomerId        String?
  stripeSubscriptionId    String?
  hasUsedTrial            Boolean                  @default(false)
  trialStartedAt          DateTime?
  planRenewsAt            DateTime?
  planInterval            String?
  emailVerifiedAt         DateTime?
  betaAccessGrantedAt     DateTime?
  checkoutAttempt         CheckoutAttempt?
  emailVerificationTokens EmailVerificationToken[]
  favorites               Favorite[]
  passwordResetTokens     PasswordResetToken[]
  referralCode            ReferralCode?
  accessGrants            AccessGrant[]
  betaInvitesRedeemed     BetaInvite[]             @relation("BetaInviteRedeemedBy")
}

model EmailVerificationToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model CheckoutAttempt {
  id              String   @id @default(cuid())
  userId          String   @unique
  stripeSessionId String?  @unique
  billing         String
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model Favorite {
  id         String    @id @default(cuid())
  userId     String
  playerId   Int
  playerName String
  team       String
  stat       String
  avg        Float
  createdAt  DateTime  @default(now())
  gameDate   DateTime?
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, playerId, stat])
  @@index([userId, createdAt(sort: Desc)])
}

model ReferralCode {
  id        String        @id @default(cuid())
  code      String        @unique
  partnerId String        @unique
  createdAt DateTime      @default(now())
  partner   User          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  uses      ReferralUse[]
}

model ReferralUse {
  id              String       @id @default(cuid())
  referralCodeId  String
  referredUserId  String       @unique
  discountApplied Boolean      @default(false)
  amountPaid      Int?
  stripeSessionId String?
  createdAt       DateTime     @default(now())
  referralCode    ReferralCode @relation(fields: [referralCodeId], references: [id], onDelete: Cascade)
}

model StripeWebhookEvent {
  id          String   @id
  type        String
  processedAt DateTime @default(now())
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model BetaWaitlist {
  id         String       @id @default(cuid())
  email      String       @unique
  status     String       @default("pending")
  approvedAt DateTime?
  rejectedAt DateTime?
  notes      String?
  createdAt  DateTime     @default(now())
  invites    BetaInvite[]

  @@index([createdAt])
  @@index([status, createdAt])
}

model BetaInvite {
  id            String       @id @default(cuid())
  waitlistEmail String
  codeHash      String       @unique
  status        String       @default("active")
  expiresAt     DateTime
  usedAt        DateTime?
  usedByUserId  String?
  revokedAt     DateTime?
  createdAt     DateTime     @default(now())
  waitlist      BetaWaitlist @relation(fields: [waitlistEmail], references: [email], onDelete: Restrict)
  usedByUser    User?        @relation("BetaInviteRedeemedBy", fields: [usedByUserId], references: [id], onDelete: SetNull)

  @@index([waitlistEmail, status])
  @@index([usedByUserId])
}

model BetaCampaign {
  id           String        @id @default(cuid())
  slug         String        @unique
  name         String
  endsAt       DateTime?
  createdAt    DateTime      @default(now())
  accessGrants AccessGrant[]
}

model AccessGrant {
  id         String       @id @default(cuid())
  userId     String
  campaignId String
  access     String       @default("pro_access")
  status     String       @default("active")
  grantedAt  DateTime     @default(now())
  expiresAt  DateTime?
  revokedAt  DateTime?
  notes      String?
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  campaign   BetaCampaign @relation(fields: [campaignId], references: [id], onDelete: Restrict)

  @@unique([userId, campaignId, access])
  @@index([userId, status])
  @@index([campaignId, status])
}
