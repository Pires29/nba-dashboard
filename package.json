{
  "name": "nba-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:qa": "QA_MODE=true QA_ALLOW_PRODUCTION_LOCAL=true next build",
    "start": "next start",
    "start:qa": "QA_MODE=true QA_ALLOW_PRODUCTION_LOCAL=true next start",
    "lint": "eslint",
    "test": "node --test tests/*.test.mjs",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "check": "npm run lint && npm test && npm run build",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@sentry/nextjs": "^10.73.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.4.0",
    "next": "^16.3.0",
    "next-auth": "^4.24.15",
    "posthog-js": "^1.422.5",
    "prisma": "5.22.0",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "recharts": "3.7.0",
    "sonner": "^2.0.7",
    "stripe": "^20.4.1"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.3.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "^16.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0"
  }
}
