# Production only. Configure these in the hosting provider, not in git.
# Use separate production Supabase, Stripe, Google OAuth, and secrets.

# Production Supabase PostgreSQL.
# DATABASE_URL should usually be the pooled connection string.
# DIRECT_URL should be the direct/session connection string for migrations.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-...pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-...pooler.supabase.com:5432/postgres"

# Production public URLs.
NEXTAUTH_URL="https://www.propinsight.app"
NEXT_PUBLIC_APP_URL="https://www.propinsight.app"
NEXT_PUBLIC_APP_ENV="production"

# Production-only secrets. Generate unique values; never reuse local secrets.
NEXTAUTH_SECRET="replace-with-production-secret"
CLEANUP_SECRET="replace-with-production-cleanup-secret"

# Cloudflare Turnstile bot protection.
NEXT_PUBLIC_TURNSTILE_SITE_KEY="0x4AAAA..."
TURNSTILE_SECRET_KEY="0x4AAAA..."

# Launch phase: "beta", "early_access", or "public".
APP_PHASE="beta"
NEXT_PUBLIC_APP_PHASE="beta"

# Legacy closed beta flag. Prefer APP_PHASE for new environments.
CLOSED_BETA="true"
BETA_ACCESS_SECRET="replace-with-production-beta-secret"

# Google OAuth production client.
GOOGLE_CLIENT_ID="..."
GOOGLE_CLIENT_SECRET="..."

# Stripe live mode only.
STRIPE_SECRET_KEY="sk_live_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_MONTHLY="price_live_monthly"
STRIPE_PRICE_SEASON="price_live_season"
STRIPE_REFERRAL_COUPON_ID="coupon_live_referral"

# Transactional email.
EMAIL_PROVIDER="resend"
EMAIL_FROM="PropInsight <noreply@propinsight.app>"
RESEND_API_KEY="re_..."

# Sentry error monitoring and sourcemap uploads.
SENTRY_DSN="https://..."
NEXT_PUBLIC_SENTRY_DSN="https://..."
SENTRY_AUTH_TOKEN="sntrys_..."
SENTRY_ORG="..."
SENTRY_PROJECT="..."

# Production safety.
QA_MODE="false"
QA_ALLOW_PRODUCTION_LOCAL="false"
QA_SECRET=""

# Production NBA data storage. Keep the service role key server-side only.
NBA_DATA_SOURCE="storage"
NBA_STORAGE_MANIFEST="current.json"
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_STORAGE_BUCKET="nba-data"
