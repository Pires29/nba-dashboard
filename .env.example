# Shared variable reference. For actual setup, copy one of:
# - .env.local.example -> .env.local
# - .env.production.example -> hosting provider environment variables
# - .env.pipeline.example -> .env.pipeline

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-long-random-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_ENV="development"

GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_MONTHLY="price_..."
STRIPE_PRICE_SEASON="price_..."
STRIPE_REFERRAL_COUPON_ID="coupon_..."

# Error monitoring. SENTRY_AUTH_TOKEN/ORG/PROJECT are only needed by CI/hosting
# when uploading production sourcemaps.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""
SENTRY_ORG=""
SENTRY_PROJECT=""

CLEANUP_SECRET="generate-a-separate-long-random-secret"

# Local QA console. Production access additionally requires a localhost host.
QA_MODE="false"
QA_ALLOW_PRODUCTION_LOCAL="false"
QA_SECRET="generate-a-separate-long-random-secret"

# Private server-side NBA data source. Never prefix the secret with NEXT_PUBLIC_.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."
SUPABASE_STORAGE_BUCKET="nba-data"
NBA_DATA_SOURCE="storage"
