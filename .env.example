# Local QA console. Never enable this in a production environment.
QA_MODE="false"
QA_SECRET="generate-a-separate-long-random-secret"

# Private server-side NBA data source. Never prefix the secret with NEXT_PUBLIC_.
SUPABASE_URL="https://PROJECT_REF.supabase.co"
